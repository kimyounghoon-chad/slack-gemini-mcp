# Slack Bot Token (xoxb-로 시작)
# Slack App 생성 후 Bot User OAuth Token을 입력
# 필요한 권한: channels:read, channels:history, users:read, search:read
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Google Gemini API Key
# Google AI Studio에서 발급: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 기본 Slack 채널 ID (선택사항)
# 시작 시 자동으로 로드할 채널
SLACK_CHANNEL_ID=
